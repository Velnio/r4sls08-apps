{
  "arch": [
    "amd64",
    "aarch64"
  ],
  "boot": "manual_only",
  "description": "Install Velnio from a private image using Home Assistant Registry credentials.",
  "docker_api": false,
  "full_access": false,
  "hassio_api": true,
  "hassio_role": "homeassistant",
  "homeassistant": "2026.9.1",
  "homeassistant_api": true,
  "host_network": false,
  "init": true,
  "map": [
    {
      "path": "/config",
      "read_only": false,
      "type": "homeassistant_config"
    }
  ],
  "name": "Velnio Installer",
  "options": {
    "backup_count": 5,
    "health_timeout": 180,
    "product": "velnio",
    "retry_failed_release": false,
    "rollback_to": ""
  },
  "privileged": [],
  "schema": {
    "backup_count": "int(1,100)",
    "health_timeout": "int(1,3600)",
    "product": "list(velnio)",
    "retry_failed_release": "bool",
    "rollback_to": "str"
  },
  "slug": "velnio_installer",
  "stage": "stable",
  "startup": "application",
  "version": "1.0.22",
  "breaking_versions": [
    "1.0.20",
    "1.0.21"
  ],
  "image": "ghcr.io/velnio/velnio-installer"
}
