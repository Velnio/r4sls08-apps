{
  "apparmor": true,
  "arch": [
    "aarch64",
    "amd64"
  ],
  "boot": "manual",
  "description": "Authenticated, read-only health metrics for a qualified HA pilot",
  "hassio_api": true,
  "hassio_role": "default",
  "homeassistant_api": true,
  "host_network": true,
  "image": "ghcr.io/velnio/velnio-health-agent",
  "init": false,
  "name": "Velnio Health Agent",
  "options": {
    "heartbeat_enabled": false,
    "host_bindings": {},
    "interval_seconds": 30,
    "listen_address": "127.0.0.1",
    "stale_seconds": 90,
    "timeout_seconds": 5
  },
  "schema": {
    "heartbeat_enabled": "bool",
    "host_bindings": {
      "boot_timestamp": "str?",
      "cpu_utilization": "str?",
      "memory_available": "str?",
      "memory_used": "str?",
      "source_profile": "list(core-2026.9.3-haos-systemmonitor|core-2026.10.1-haos-systemmonitor)?",
      "temperature": "str?"
    },
    "interval_seconds": "int(5,300)",
    "listen_address": "str",
    "stale_seconds": "int(10,900)",
    "timeout_seconds": "int(1,5)"
  },
  "slug": "velnio_health",
  "startup": "application",
  "url": "https://github.com/Velnio/velnio-backup",
  "version": "0.3.0"
}
